# Local development: run `./install.sh` to generate .env with paths under ./data
# Docker: compose sets DJ_*=/data/... — see docker-compose.yml
#
# System tools (NOT installed by install.sh — install on your host):
#   ffmpeg, fpcalc (chromaprint) — required for worker
#   essentia — optional for local dev (included in Docker backend image)

# Phase 4 — metadata (optional AcoustID key; without key: embedded tags + filename + MusicBrainz search)
# DJ_ACOUSTID_API_KEY=
# DJ_TAG_CONFIDENCE_THRESHOLD=0.5
# DJ_NAMING_TEMPLATE={title} - {artist} ({mix}){ext}

# Key display in dashboard (defaults; overridable in Settings UI): camelot | traditional
# DJ_KEY_NOTATION=camelot

# Routing gates (defaults; overridable in Settings UI)
# DJ_REVIEW_LUFS_THRESHOLD=-18
# DJ_REVIEW_TRUE_PEAK_DB=3.0
# DJ_REVIEW_MIN_MP3_BITRATE_KBPS=320
# DJ_REVIEW_MIN_LOSSLESS_BIT_DEPTH=16
# DJ_REVIEW_MIN_LOSSLESS_SAMPLE_RATE_HZ=44100

DJ_ENV=development
DJ_LOG_LEVEL=INFO

DJ_API_HOST=0.0.0.0
DJ_API_PORT=8000
DJ_WORKER_CPU_LIMIT=1.0
DJ_WORKER_MEM_LIMIT=1g
