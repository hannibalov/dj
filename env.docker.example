# Copy to .env on the Docker host (Pi or server).
# docker-compose.yml overrides folder paths to /data/... inside containers.

DJ_ENV=production
DJ_LOG_LEVEL=INFO

# AcoustID + MusicBrainz: artist/title and genre/subgenre at TAG (https://acoustid.org/new-application)
DJ_ACOUSTID_API_KEY=

# Optional tuning
# DJ_TAG_CONFIDENCE_THRESHOLD=0.5
# DJ_NAMING_TEMPLATE={title} - {artist} ({mix}){ext}
# DJ_REVIEW_LUFS_THRESHOLD=-18
# DJ_REVIEW_TRUE_PEAK_DB=3.0
# DJ_REVIEW_MIN_MP3_BITRATE_KBPS=320
# DJ_REVIEW_MIN_LOSSLESS_BIT_DEPTH=16
# DJ_REVIEW_MIN_LOSSLESS_SAMPLE_RATE_HZ=44100

# Internal — leave as-is when using default compose network
# DJ_API_INTERNAL_URL=http://api:8000
# DJ_DATABASE_URL=sqlite:////data/dj_library.db
