FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libchromaprint-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/pyproject.toml backend/README.md ./
RUN pip install --no-cache-dir -e .

COPY backend/app ./app

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Essentia: optional; loudness uses ffmpeg. For BPM/key on Pi, build Essentia from source
# or use a multi-stage image — see docs/PHASE2.md.
# Metadata: pyacoustid in pip deps; set DJ_ACOUSTID_API_KEY for MusicBrainz/AcoustID lookup.

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
