# Essentia is built from source (no arm64 wheels). Pinned to MTG/essentia master for Python 3.11.
FROM python:3.11-slim-bookworm AS essentia-builder

ARG ESSENTIA_GIT_REF=b9fa6cb674ca43dfb94d28d293aeda441c6745db

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git pkg-config python3-dev \
    libfftw3-dev libavcodec-dev libavformat-dev libavutil-dev libswresample-dev \
    libsamplerate0-dev libtag1-dev libchromaprint-dev libyaml-dev libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "numpy>=1.26,<2"

RUN git clone https://github.com/MTG/essentia.git /tmp/essentia \
    && cd /tmp/essentia \
    && git checkout "${ESSENTIA_GIT_REF}" \
    && find . -path '*/waflib/Utils.py' -exec sed -i "s/m='rUb'/m='rU'/g" {} + \
    && python3 waf configure --with-python \
    && python3 waf -j"$(nproc)" \
    && python3 waf install \
    && ldconfig \
    && rm -rf /tmp/essentia

RUN pip install --no-cache-dir six pyyaml \
    && python3 -c "import essentia.standard as es; print('essentia', es)"

FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libchromaprint-tools \
    libfftw3-double3 libfftw3-single3 \
    libavcodec59 libavformat59 libavutil57 libswresample4 \
    libsamplerate0 libtag1v5 libyaml-0-2 \
    libmp3lame0 \
    nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# Some Debian packages install the binary as `nodejs` instead of `node`.
RUN if [ ! -x "$(command -v node 2>/dev/null)" ] && [ -x "$(command -v nodejs 2>/dev/null)" ]; then \
    ln -s "$(command -v nodejs)" /usr/bin/node; \
    fi

COPY --from=essentia-builder /usr/local/lib/libessentia.so* /usr/local/lib/
COPY --from=essentia-builder /usr/local/lib/python3.11/site-packages/essentia /usr/local/lib/python3.11/site-packages/essentia

RUN ldconfig \
    && pip install --no-cache-dir "numpy>=1.26,<2" six pyyaml

WORKDIR /app

COPY backend/pyproject.toml backend/README.md ./
RUN pip install --no-cache-dir -e .

COPY backend/app ./app

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
